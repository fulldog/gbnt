{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@gbnt/api-client": ["./packages/api-client/src/index.ts"],
      "@gbnt/api-client/*": ["./packages/api-client/src/*"]
    }
  }
}
