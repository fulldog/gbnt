{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@gbnt/api-client": ["../../packages/api-client/src/index.ts"],
      "@gbnt/api-client/*": ["../../packages/api-client/src/*"]
    },
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "types": ["@dcloudio/types", "vite/client"]
  },
  "vueCompilerOptions": {
    "strictTemplates": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "tests/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
